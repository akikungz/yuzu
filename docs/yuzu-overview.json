          "refId": "A"
        }
      ],
      "title": "Jobs processed (rate)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(yuzu_active_jobs) by (queue)",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
