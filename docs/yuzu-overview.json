      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(yuzu_job_duration_seconds_bucket[5m])) by (le, queue))",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "title": "p95 job duration",
      "type": "timeseries"
