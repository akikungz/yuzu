# Environment
NODE_ENV=development # Example: development

# Proxmox VE API
PVE_API_URL=https://your-pve-host:8006 # Example: https://pve.example.com:8006
PVE_API_TOKEN_ID=user@pam!token-name # Example: root@pam!yuzu
PVE_API_TOKEN_SECRET=your-api-token-secret # Example: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/yuzu # Example: postgresql://yuzu:secret@localhost:5432/yuzu

# Redis
REDIS_URL=redis://localhost:6379 # Example: redis://localhost:6379

# OpenTelemetry / OTLP (optional)
OTEL_SERVICE_NAME=yuzu # Example: yuzu
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317 # Example: http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=grpc # Example: http
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs # Optional override
# OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=grpc # Optional logs protocol override
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics # Optional override
# OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=grpc # Optional metrics protocol override
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer token # Optional shared headers
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=x-scope-orgid=tenant-a # Optional logs headers
# OTEL_EXPORTER_OTLP_METRICS_HEADERS=x-scope-orgid=tenant-a # Optional metrics headers
OTEL_METRIC_EXPORT_INTERVAL_MILLIS=10000 # Example: 10000
OTEL_EXPORT_TIMEOUT_MILLIS=30000 # Example: 30000
