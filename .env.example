# Environment
NODE_ENV=development # Example: development

# Proxmox VE API
PVE_API_URL=https://your-pve-host:8006 # Example: https://pve.example.com:8006
PVE_API_TOKEN_ID=user@pam!token-name # Example: root@pam!yuzu
PVE_API_TOKEN_SECRET=your-api-token-secret # Example: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/yuzu # Example: postgresql://yuzu:secret@localhost:5432/yuzu

# Redis
REDIS_URL=redis://localhost:6379 # Example: redis://localhost:6379

# Logging (optional)
LOG_PRETTY=true # Example: true

# Prometheus Metrics (optional, default: 9090)
METRICS_PORT=9090 # Example: 9090

# Loki Logging (optional)
LOKI_ENABLED=false # Example: false
LOKI_HOST=http://localhost:3100 # Example: http://localhost:3100
LOKI_LABELS=app=yuzu,env=development # Example: app=yuzu,env=development
# LOKI_BASIC_AUTH_USER=your-username # Example: loki-user
# LOKI_BASIC_AUTH_PASSWORD=your-password # Example: loki-pass
