		"prisma": "^7.7.0"
	},
	"peerDependencies": {
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@grpc/grpc-js": "^1.14.3",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/api-logs": "^0.216.0",
		"@opentelemetry/exporter-logs-otlp-grpc": "^0.216.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.216.0",
